# CropScan AI - Server Environment Variables

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=cropscan_ai_super_secret_jwt_key_2026_musa_final_year_project
JWT_EXPIRES_IN=7d

# Database Configuration (MongoDB Atlas connection URI or local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cropscan?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cropscan_ai

# Google Gemini API
# Get key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Cloudinary Image Storage (Free Tier)
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
